# ========================================
# FLUENIX MOBILE - PRODUCTION ENVIRONMENT
# ========================================
# When building for production via Expo Application Services (EAS), 
# you should define these variables in the EAS Dashboard as 'Secrets', 
# rather than hardcoding them here.
# 
# However, if you are building locally, create a .env.production file:

EXPO_PUBLIC_API_URL="https://your-node-backend.com"
EXPO_PUBLIC_AI_API_URL="https://your-python-backend.com"

# Clerk Authentication (Live Keys)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_***"
