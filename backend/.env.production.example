# ========================================
# FLUENIX BACKEND - PRODUCTION ENVIRONMENT
# ========================================
# Copy this file to .env.production and fill in the values before deploying.
# Make sure to grab the LIVE keys, not the development keys.

# Environment
NODE_ENV="production"
PORT=3001
CORS_ORIGIN="https://your-production-web-domain.com"

# Prisma Database connection (Add connection limits to prevent exhaustion)
DATABASE_URL="postgresql://user:password@host:port/database?connection_limit=10&pool_timeout=10"

# Clerk Authentication (Live Keys)
CLERK_SECRET_KEY="sk_live_***"
CLERK_PUBLISHABLE_KEY="pk_live_***"

# Upstash Redis
UPSTASH_REDIS_REST_URL="https://***.upstash.io"
UPSTASH_REDIS_REST_TOKEN="***"

# AI Service Connection
AI_SERVICE_URL="http://ai-service-internal-ip:8000"
