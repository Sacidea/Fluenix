generator client {
  provider   = "prisma-client-js"
  engineType = "library" 
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String     @id @default(cuid())
  email       String     @unique
  name        String?
  level       String     @default("beginner")
  targetGoal  String?
  streak      Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  progress    Progress[]

  seenListening  UserSeenListening[]
  seenGrammar    UserSeenGrammar[]
  seenErrors     UserSeenError[]
  seenBehavioral UserSeenBehavioral[]
  seenWriting    UserSeenWriting[]
  seenVocab      UserSeenVocab[]
  seenRoleplay   UserSeenRoleplay[]
  masteredPronun UserMasteredPronunciation[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  type      String
  scenario  String?
  duration  Int      @default(0)
  score     Float?
  feedback  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

model Progress {
  id        String   @id @default(cuid())
  userId    String
  skill     String
  score     Float
  date      DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id        String   @id @default(cuid())
  name      String
  domain    String?  @unique
  plan      String   @default("starter")
  createdAt DateTime @default(now())
  employees Employee[]
}

model Employee {
  id        String   @id @default(cuid())
  userId    String   @unique
  companyId String
  role      String   @default("employee")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model PronunciationWord {
  id        String   @id @default(cuid())
  word      String   @unique
  category  String
  phonetic  String
  createdAt DateTime @default(now())

  masteredBy UserMasteredPronunciation[]
}

model UserMasteredPronunciation {
  id         String   @id @default(cuid())
  userId     String
  wordId     String
  createdAt  DateTime @default(now())

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  word       PronunciationWord  @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
}

model ListeningScenario {
  id        String   @id @default(cuid())
  title     String
  context   String
  level     String   @default("B1") // CEFR level: B1, B2, C1
  dialogue  Json
  questions Json
  dictation Json?
  shadowing Json?
  createdAt DateTime @default(now())

  seenBy    UserSeenListening[]
  @@index([level])
}

model UserSeenListening {
  id         String   @id @default(cuid())
  userId     String
  scenarioId String
  createdAt  DateTime @default(now())

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario   ListeningScenario  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([userId, scenarioId])
}

model GrammarExercise {
  id        String   @id @default(cuid())
  title     String
  context   String
  level     String   @default("B1") // CEFR level: B1, B2, C1
  segments  Json
  createdAt DateTime @default(now())

  seenBy    UserSeenGrammar[]
  @@index([level])
}

model GrammarRule {
  id             String   @id @default(cuid())
  category       String
  title          String
  explanation    String
  correctExample String
  wrongExample   String
  lessonContent  String?
  level          String   @default("B1")
  createdAt      DateTime @default(now())
}

model ErrorScenario {
  id        String   @id @default(cuid())
  role      String
  level     String
  scenario  Json
  createdAt DateTime @default(now())

  seenBy    UserSeenError[]
  @@index([role, level])
}

model UserSeenError {
  id         String   @id @default(cuid())
  userId     String
  scenarioId String
  createdAt  DateTime @default(now())

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario   ErrorScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([userId, scenarioId])
}

model UserSeenGrammar {
  id         String   @id @default(cuid())
  userId     String
  exerciseId String
  createdAt  DateTime @default(now())

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   GrammarExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
}

model BehavioralQuestion {
  id        String   @id @default(cuid())
  category  String
  context   String
  question  String
  level     String   @default("B2")
  createdAt DateTime @default(now())

  seenBy    UserSeenBehavioral[]
  @@index([level])
}

model UserSeenBehavioral {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  createdAt  DateTime @default(now())

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   BehavioralQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model WritingMission {
  id            String   @id @default(cuid())
  category      String   // 'pr_description', 'commit_message', 'email'
  level         String   @default("B2")
  title         String
  context       String
  referenceData String
  createdAt     DateTime @default(now())

  seenBy        UserSeenWriting[]
  @@index([category, level])
}

model UserSeenWriting {
  id         String   @id @default(cuid())
  userId     String
  missionId  String
  createdAt  DateTime @default(now())

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission    WritingMission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
}

model VocabWord {
  id              String   @id @default(cuid())
  word            String   @unique
  difficulty      String   @default("medium") // easy, medium, hard, expert
  type            String   // noun, verb, adj, etc.
  definition      String
  phonetic        String
  turkishMeaning  String
  contextSentence String
  createdAt       DateTime @default(now())

  seenBy          UserSeenVocab[]
  @@index([difficulty])
}

model UserSeenVocab {
  id         String   @id @default(cuid())
  userId     String
  wordId     String
  createdAt  DateTime @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  word       VocabWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
}

model RoleplayMission {
  id        String   @id @default(cuid())
  category  String   // interview, standup, code_review
  level     String   @default("B2")
  content   String
  createdAt DateTime @default(now())

  seenBy    UserSeenRoleplay[]
  @@index([category, level])
}

model UserSeenRoleplay {
  id         String   @id @default(cuid())
  userId     String
  missionId  String
  createdAt  DateTime @default(now())

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission    RoleplayMission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
}