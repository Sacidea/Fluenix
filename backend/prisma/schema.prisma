generator client {
  provider   = "prisma-client-js"
  
  engineType = "library" 
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String     @id @default(cuid())
  email       String     @unique
  name        String?
  level       String     @default("beginner")
  targetGoal  String?
  streak      Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  progress    Progress[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  type      String
  scenario  String?
  duration  Int      @default(0)
  score     Float?
  feedback  Json?
  createdAt DateTime @default(now())
}

model Progress {
  id        String   @id @default(cuid())
  userId    String
  skill     String
  score     Float
  date      DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id        String   @id @default(cuid())
  name      String
  domain    String?  @unique
  plan      String   @default("starter")
  createdAt DateTime @default(now())
  employees Employee[]
}

model Employee {
  id        String   @id @default(cuid())
  userId    String   @unique
  companyId String
  role      String   @default("employee")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model PronunciationWord {
  id        String   @id @default(cuid())
  word      String   @unique
  category  String
  phonetic  String
  createdAt DateTime @default(now())
}

model ListeningScenario {
  id        String   @id @default(cuid())
  title     String
  context   String
  level     String   @default("B1") // CEFR level: B1, B2, C1
  dialogue  Json
  questions Json
  dictation Json?
  shadowing Json?
  createdAt DateTime @default(now())
}

model GrammarExercise {
  id        String   @id @default(cuid())
  title     String
  context   String
  level     String   @default("B1") // CEFR level: B1, B2, C1
  segments  Json
  createdAt DateTime @default(now())
}

model GrammarRule {
  id             String   @id @default(cuid())
  category       String
  title          String
  explanation    String
  correctExample String
  wrongExample   String
  lessonContent  String?
  level          String   @default("B1")
  createdAt      DateTime @default(now())
}