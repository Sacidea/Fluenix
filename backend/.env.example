# ─── Database ────────────────────────────────────────────
# If you are using Supabase or Neon in Production (Serverless),
# you MUST use the connection pooling URL (usually port 6543) for DATABASE_URL.
DATABASE_URL="postgresql://user:password@localhost:5432/fluenix?schema=public"

# DIRECT_URL is required by Prisma for migrations. 
# Use the direct session URL (usually port 5432).
DIRECT_URL="postgresql://user:password@localhost:5432/fluenix?schema=public"

# ─── Authentication (Clerk) ──────────────────────────────
CLERK_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ─── AI Service ──────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ─── Server-to-Server Auth ───────────────────────────────
# Shared secret between backend and AI service
INTERNAL_API_SECRET=your_strong_random_secret_here

# ─── CORS ────────────────────────────────────────────────
# For production, list allowed domains separated by commas. Example:
# CORS_ORIGINS=http://localhost:3000,https://fluenix.vercel.app,https://your-domain.com
CORS_ORIGINS=http://localhost:3000

# ─── Upstash Redis ───────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here
